{
  // Static-asset deploy of the built spec-review UI to Cloudflare Workers.
  //
  // There is no server side. The emitters are deterministic and run in the
  // browser, PGlite is a wasm Postgres that runs in the browser, and the only
  // network call the app can make is the analyst's own key to Anthropic. So this
  // is a pure asset upload, and nothing about a deployed copy is more privileged
  // than a local one. That is the point: an analyst can read the source, run the
  // same verification here that CI runs, and never send a protocol anywhere.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heor-studio",
  // No Worker script. Assets-only deploys still need a compatibility date.
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./dist",
    // NOT "single-page-application", which is what this said first, on the
    // assumption that React Router owned the paths. It does not: there is no
    // router in packages/web/src at all. The app is one page with panels.
    //
    // The assumption was not merely wrong, it was ACTIVELY HARMFUL. SPA fallback
    // serves index.html for any unmatched path, so a missing hashed asset comes
    // back as HTTP 200 with content-type text/html instead of a 404. The browser
    // then fails to parse HTML as a JavaScript module, and the error surfaces as
    // "Failed to fetch dynamically imported module" with no hint that the file is
    // simply absent. A half-uploaded deploy looks like a healthy one, and the
    // verification chunk, which is the whole point of this app, is exactly the
    // kind of lazily imported file that would go missing.
    //
    // "none" returns a real 404, so a broken deploy reports itself.
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
