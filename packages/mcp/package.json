{
  "name": "@heor-studio/mcp",
  "version": "0.1.0",
  "description": "MCP server for HEOR Studio \u2014 turns a reviewed study spec into deterministic SAS + SQL for MarketScan. Deterministic tools by default; an LLM extract tool activates only when an API key is present.",
