    "build": "tsup",
    "smoke": "tsx test/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "jszip": "^3.10.1",
