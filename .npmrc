# The web build needs Node >=22.12 (package.json "engines"). Without this,
# npm ci exits 0 on an older Node, prints three EBADENGINE warnings nobody reads,
# and SILENTLY SKIPS the optional native binding @rolldown/binding-darwin-arm64.
# Then `npm run build` fails with "Cannot find native binding" and advises
# deleting package-lock.json, which does not fix it and destroys the
# reproducibility CI depends on. typecheck and mcp:smoke still pass, so it reads
# as random rather than as a version problem.
#
# engine-strict turns the silent skip into a refusal that names the version.
engine-strict=true
